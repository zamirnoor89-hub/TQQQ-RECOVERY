{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "lib": ["ES2022"],
    "types": ["node"],
    "typeRoots": ["/opt/node-tools/node_modules/@types"],
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true
  },
  "include": ["server/**/*.ts"]
}
